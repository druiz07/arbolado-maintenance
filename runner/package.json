{
  "name": "arbolado-maintenance-runner",
  "version": "0.2.0",
  "private": true,
  "description": "Runner del loop de mantenimiento autónomo (policy engine + playbook loader + aider invoker + classifier + router). Sin dependencia del producto.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec policy-engine/*.test.js playbook-loader/*.test.js aider-invoker/*.test.js",
    "test:watch": "node --test --watch --test-reporter=spec policy-engine/*.test.js playbook-loader/*.test.js aider-invoker/*.test.js"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "semver": "^7.6.0"
  },
  "devDependencies": {}
}
