# Plantilla de variables de entorno para arbolado-maintenance.
# Copia a `.env` para desarrollo local. NUNCA commitear .env (ya cubierto por .gitignore).
# Los mismos nombres se usan como secrets en GitHub Actions
# (Settings → Secrets and variables → Actions del repo).

# ─────────────────────────────────────────────────────────
# Groq Cloud — executor primario (Kimi K2 vía Aider)
# https://console.groq.com/keys
# Free tier: ~14 400 req/día
# ─────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────
# Google AI Studio — classifier signal→playbook + fallback executor
# (Gemini 2.5 Flash)
# https://aistudio.google.com/app/apikey
# Free tier: ~1 500 req/día, 15 req/min
# ─────────────────────────────────────────────────────────
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────
# GitHub fine-grained PAT con scope ÚNICAMENTE a druiz07/arbolado-app
# Permisos: contents:write, pull_requests:write, actions:read, metadata:read
# https://github.com/settings/personal-access-tokens
# Rotación: 90 días
# ─────────────────────────────────────────────────────────
GH_PAT_ARBOLADO_APP=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────
# Cloudflare — detector Worker + KV state store
# IDs públicos (no secret), valores reales en cloudflare/NOTES.md
# ─────────────────────────────────────────────────────────
CF_ACCOUNT_ID=e4ccfa519c1e0fb94221ca6583220545
CF_KV_NAMESPACE_ID=212fe2e1b8874298ad44a9a906375033

# ─────────────────────────────────────────────────────────
# Cloudflare API token — usado por el job observe-signals del workflow
# loop.yml para listar signal:* del KV via wrangler kv key list/get.
# Permisos: Workers KV Storage → Read sobre la cuenta de arriba.
# https://dash.cloudflare.com/profile/api-tokens
# Rotación: 90 días. Runbook: arbolado-app/docs/incident-response.md §2.5
# ─────────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=cf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────
# OpenRouter — backup executor (diferido a Sem 2-3, no necesario en Sesión 0)
# Cuando se active: https://openrouter.ai/keys
# ─────────────────────────────────────────────────────────
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
